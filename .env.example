# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Site — lida só no servidor, para montar links dos e-mails.
# Sem prefixo NEXT_PUBLIC_: o valor não precisa ir para o navegador.
SITE_URL=

# Resend
RESEND_API_KEY=
# Precisa ser de um domínio verificado no Resend
RESEND_FROM=
# Caixa que recebe as respostas dos clientes (pode ser Gmail)
RESEND_REPLY_TO=

# Bling
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=

# Segredo das rotas agendadas (/api/cron/*): quem chama manda
# Authorization: Bearer <valor>. O agendamento é o workflow
# .github/workflows/baixa-pagamentos.yml, que lê o mesmo valor dos
# secrets do GitHub (CRON_SECRET + SITE_URL). Sem ele a rota recusa.
CRON_SECRET=

# Leitura de notas de despesa por IA (Claude). Sem ela, a tela de despesas
# só aceita preenchimento à mão.
ANTHROPIC_API_KEY=
