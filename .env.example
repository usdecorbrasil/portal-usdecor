# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Site — lida só no servidor, para montar links dos e-mails.
# Sem prefixo NEXT_PUBLIC_: o valor não precisa ir para o navegador.
SITE_URL=

# Resend
RESEND_API_KEY=
# Precisa ser de um domínio verificado no Resend
RESEND_FROM=
# Caixa que recebe as respostas dos clientes (pode ser Gmail)
RESEND_REPLY_TO=

# Bling
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=

# Vercel Cron — segredo que a Vercel manda em Authorization: Bearer <valor>
# nas chamadas agendadas (vercel.json). Sem ele a rota /api/cron/* recusa.
CRON_SECRET=
